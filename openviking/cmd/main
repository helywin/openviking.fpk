#!/bin/bash
set -eu
source "$(dirname "$0")/common.sh"
case "${1:-}" in
start)
        bash "$(dirname "$0")/install_callback" --image-only
        prepare_storage
        compose_app up -d --pull never || fail '容器启动失败'
        for attempt in $(seq 1 150); do
            state=$(docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{end}}' "$CONTAINER_NAME" 2>/dev/null || true)
            [ "$state" = healthy ] && exit 0
            sleep 1
        done
        fail '应用初始化超时，请检查日志'
    exit 0 ;;
stop)
    compose_app stop --timeout 30
    exit 0 ;;
status)
    name=$CONTAINER_NAME
    state=$(docker inspect --format '{{.State.Status}}/{{if .State.Health}}{{.State.Health.Status}}{{end}}' "$name" 2>/dev/null) || exit 3
    [ "$state" = "running/healthy" ] && exit 0
    exit 3 ;;
*) exit 1 ;;
esac
